# Root environment overview (valid env syntax)
#
# This file is the human index for configuration. The canonical templates are:
#   apps/api/.env.example   -> copy to apps/api/.env.local and fill in
# Web (Vite) reads only VITE_-prefixed vars (currently just VITE_API_BASE_URL
# when deploying split; the default same-origin deployment needs none).
# `.env` / `*.env.local` are gitignored.

# --- apps/api (see apps/api/.env.example for the full verified list) ---
# API ports: PORT=3001 (3000 is force-shifted to 3001; API_PORT overrides)
# DATABASE_URL=mongodb://localhost:27017/family-portal
# WEB_ORIGIN=http://localhost:3000
# AUTH_ACCESS_TOKEN_SECRET=change-me-min-32-chars
# AUTH_REFRESH_TOKEN_SECRET=change-me-min-32-chars
# RESEND_API_KEY=
# R2_ACCOUNT_ID=            (set all four R2_* together)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kulaya-photos
# UPLOAD_DAILY_BYTES=209715200
# UPLOAD_DAILY_FILES=100
# FAMILY_QUOTA_BYTES=8589934592
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- apps/web ---
# VITE_API_BASE_URL=https://kulaya.family     # only for split-origin deploys
