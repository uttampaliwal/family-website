# Environment Variables

> Copy each `.env.example` to `<app>/.env.local` and fill in real values.

## apps/api
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB (Atlas M0 free tier or local)
DATABASE_URL=mongodb://localhost:27017/family-portal

# Auth
AUTH_ACCESS_TOKEN_SECRET=change-me-min-32-chars
AUTH_REFRESH_TOKEN_SECRET=change-me-min-32-chars
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

# Frontend origin (comma separated in prod)
WEB_ORIGIN=http://localhost:5173

# Email (Resend free tier)
EMAIL_FROM=Family Portal <family@example.com>
RESEND_API_KEY=