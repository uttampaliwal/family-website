# Family Portal - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# =============================================================================
# STOCK MARKET API KEYS (Optional - for live stock data)
# =============================================================================
# Breeze Connect API (ICICI Securities - Recommended for Indian markets)
# Get from: https://api.icicidirect.com/breezeapi/
VITE_BREEZE_API_KEY=your_breeze_api_key_here
VITE_BREEZE_API_SECRET=your_breeze_api_secret_here
VITE_BREEZE_SESSION_TOKEN=your_breeze_session_token_here

# Alpha Vantage API Key (Free: 25 calls/day)
# Get from: https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub API Key (Free: 60 calls/minute)
# Get from: https://finnhub.io/register
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Docker port configurations
API_PORT=3000
WEB_PORT=80

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Host (use 'mongo' for Docker, 'localhost' for local development)
MONGO_HOST=localhost
MONGO_DB_NAME=family-portal

# MongoDB Root User (for Docker initialization)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-root-password-here

# MongoDB Application User (used by the API)
MONGO_APP_USERNAME=family-portal-user
MONGO_APP_PASSWORD=your-secure-app-password-here

# Optional: Custom MongoDB data path for Docker
MONGO_DATA_PATH=./data/mongo

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secrets (MUST be 32+ characters, use strong random strings)
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
REFRESH_TOKEN_SECRET=your-super-secure-refresh-token-secret-at-least-32-characters

# CSRF Protection Secret (16+ characters)
CSRF_SECRET=your-csrf-secret-16-chars-min

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Email service configuration (for notifications, password reset, etc.)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# =============================================================================
# WEATHER API CONFIGURATION
# =============================================================================
# OpenWeatherMap API key (get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Rate limiting window (in milliseconds) - default: 15 minutes
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window - default: 100
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Log format: json, pretty
LOG_FORMAT=pretty

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
# Email address for the first admin user (for seeding)
SEED_ADMIN_EMAIL=admin@familyportal.com

# =============================================================================
# DEVELOPMENT & BUILD CONFIGURATION
# =============================================================================
# Disable Turbo telemetry
TURBO_TELEMETRY_DISABLED=1

# =============================================================================
# PRODUCTION OVERRIDES (use .env.production for production deployment)
# =============================================================================
# For production, use MongoDB Atlas or cloud database
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/family_portal_prod

# Production security settings
# NODE_ENV=production
# BCRYPT_ROUNDS=12
# LOG_LEVEL=info
# CORS_ORIGIN=https://yourdomain.com