{
  "name": "family-portal",
  "version": "0.2.5",
  "private": true,
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e ./.env -- turbo dev",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "start": "dotenv -e ./.env -- turbo start",
    "start:api": "npm run start --workspace=api",
    "start:web": "npm run preview --workspace=web",
    "build": "dotenv -e ./.env -- turbo run build --filter=web --filter=api",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "lint": "dotenv -e ./.env -- turbo lint",
    "lint:fix": "dotenv -e ./.env -- turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "type-check": "dotenv -e ./.env -- turbo type-check",
    "test": "npm test --workspace=api && npm test --workspace=web",
    "test:api": "npm test --workspace=api",
    "test:web": "npm test --workspace=web",
    "test:coverage": "npm run test:coverage --workspace=api && npm run test:coverage --workspace=web",
    "test:watch": "npm run test:watch --workspace=api & npm run test:watch --workspace=web",
    "clean": "dotenv -e ./.env -- turbo clean && npm run clean:deps",
    "clean:deps": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "reset": "npm run clean && npm install && npm run build",
    "setup": "npm install && npm run build",
    "preview": "npm run preview --workspace=web",
    "db:seed:admin": "tsx --require dotenv/config apps/api/src/scripts/seedAdmin.ts",
    "db:reset": "npm run db:seed:admin",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "health-check": "npm run health-check --workspace=api",
    "deps:update": "npx npm-check-updates -u && npm install",
    "deps:audit": "npm audit && npm audit --workspace=api && npm audit --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv-cli": "^10.0.0",
    "npm-check-updates": "^17.1.11",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.8"
  },
  "overrides": {
    "inflight": "npm:@isaacs/inflight@^1.0.6",
    "test-exclude": "^7.0.0"
  },
  "dependencies": {
    "axios-cookiejar-support": "^6.0.4",
    "tough-cookie": "^5.1.2"
  }
}