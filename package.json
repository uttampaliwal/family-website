{
  "name": "family-website",
  "version": "0.2.3",
  "private": true,
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e ./.env -- turbo dev",
    "build": "dotenv -e ./.env -- turbo build",
    "lint": "dotenv -e ./.env -- turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "npm test --workspace=api && npm test --workspace=web"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.6"
  }
}