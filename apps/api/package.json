{
  "name": "api",
  "version": "0.2.5",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "dev": "cross-env NODE_ENV=development node --import tsx/esm --require dotenv/config --watch ./src/index.ts",
    "dev:local": "cross-env MONGO_HOST=localhost node --import tsx/esm --require dotenv/config --watch ./src/index.ts",
    "dev:docker": "cross-env MONGO_HOST=mongo node --import tsx/esm --require dotenv/config --watch ./src/index.ts",
    "dev:debug": "cross-env NODE_ENV=development node --inspect --import tsx/esm --require dotenv/config --watch ./src/index.ts",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:open": "npm run test:coverage && open coverage/lcov-report/index.html",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo",
    "preview": "npm run build && npm run start",
    "health-check": "curl -f http://localhost:3000/api/health-check || exit 1",
    "activate-promotions": "cross-env NODE_ENV=production node --import tsx/esm --require dotenv/config ./src/scripts/activatePromotions.ts",
    "seed-admin": "cross-env NODE_ENV=development node --import tsx/esm --require dotenv/config ./src/scripts/seedAdmin.ts",
    "db:migrate": "node --import tsx/esm --require dotenv/config ./src/scripts/migrate.ts",
    "db:seed": "node --import tsx/esm --require dotenv/config ./src/scripts/seed.ts",
    "db:reset": "node --import tsx/esm --require dotenv/config ./src/scripts/reset.ts",
    "logs": "tail -f logs/app.log 2>/dev/null || echo 'No log file found'",
    "deps:audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/helmet": "^0.0.48",
    "@types/joi": "^17.2.2",
    "@types/node-cache": "^4.1.3",
    "@types/nodemailer": "^7.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-slow-down": "^2.0.3",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.4",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jest": "^30.0.5",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.1.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1"
  },
  "overrides": {
    "inflight": "npm:@isaacs/inflight@^1.0.6",
    "test-exclude": "^7.0.0"
  }
}
