# Multi-stage Dockerfile for optimized API build
FROM node:20-alpine AS base

# Set working directory
WORKDIR /app

# Install necessary packages for build
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    curl

# Update npm to latest version and set npm cache
RUN npm install -g npm@latest && \
    npm config set fund false && \
    npm config set audit false

# Copy package files for dependency installation
COPY package*.json ./
COPY turbo.json ./

# Stage 2: Install dependencies with better caching
FROM base AS deps
COPY apps/api/package*.json ./apps/api/
RUN npm ci --only=production --ignore-scripts

# Stage 3: Build dependencies (including dev dependencies)
FROM base AS builder
ARG TURBO_TELEMETRY_DISABLED=1
ENV TURBO_TELEMETRY_DISABLED=$TURBO_TELEMETRY_DISABLED

# Copy all source files
COPY . .

# Install all dependencies (including dev)
RUN npm ci --ignore-scripts

# Build the API
RUN npx turbo run build --filter=api

# Stage 4: Production runtime
FROM node:20-alpine AS runner
ARG TURBO_TELEMETRY_DISABLED=1
ENV TURBO_TELEMETRY_DISABLED=$TURBO_TELEMETRY_DISABLED
ENV NODE_ENV=production

WORKDIR /app

# Install curl for health checks and create non-root user
RUN apk add --no-cache curl && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nodeuser -u 1001

# Copy production dependencies from deps stage
COPY --from=deps --chown=nodeuser:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nodeuser:nodejs /app/apps/api/node_modules ./apps/api/node_modules

# Copy built application
COPY --from=builder --chown=nodeuser:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nodeuser:nodejs /app/apps/api/package.json ./apps/api/package.json

# Switch to non-root user
USER nodeuser

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/api/health-check || exit 1

# Start the application
CMD ["node", "apps/api/dist/index.js"]