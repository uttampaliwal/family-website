# Copy to apps/api/.env.local — do not commit real secrets

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB (Atlas M0 free tier or local)
DATABASE_URL=mongodb://localhost:27017/family-portal

# Frontend origin(s), comma separated in production
WEB_ORIGIN=http://localhost:5173

# Auth — use `openssl rand -base64 48` for real values
AUTH_ACCESS_TOKEN_SECRET=change-me-at-least-32-characters
AUTH_REFRESH_TOKEN_SECRET=change-me-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_MAX_ACTIVE_SESSIONS=5

# Email (Resend free tier — optional in development)
RESEND_API_KEY=
EMAIL_FROM=Kulaya <noreply@kulaya.family>

# First admin (used by `pnpm --filter @family/api seed-admin`)
ADMIN_EMAIL=