# Copy to apps/api/.env.local — do not commit real secrets

NODE_ENV=development
# API listens on :3001 — env.ts force-shifts PORT=3000 to 3001 so the Vite dev
# server (web) owns :3000. Override the final port with API_PORT if needed.
PORT=3001
LOG_LEVEL=info

# MongoDB (Atlas M0 free tier or local)
DATABASE_URL=mongodb://localhost:27017/family-portal

# Frontend origin(s), comma separated in production
WEB_ORIGIN=http://localhost:3000

# Auth — use `openssl rand -base64 48` for real values
AUTH_ACCESS_TOKEN_SECRET=change-me-at-least-32-characters
AUTH_REFRESH_TOKEN_SECRET=change-me-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_MAX_ACTIVE_SESSIONS=5

# Email (Resend free tier — optional in development)
RESEND_API_KEY=
EMAIL_FROM=Kulaya <noreply@kulaya.family>

# Photo storage (Cloudflare R2) — optional: without these, photos are stored
# on local disk (apps/api/uploads/) for development
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kulaya-photos

# Upload quotas (P2): per-member daily budget + family ceiling
UPLOAD_DAILY_BYTES=209715200     # 200 MB/member/day
UPLOAD_DAILY_FILES=100           # files/member/day
FAMILY_QUOTA_BYTES=8589934592    # 8 GB family ceiling

# First admin (used by `pnpm --filter @family/api seed-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=