# Enhanced Navigation Feature Flag
# Set to 'true' to use enhanced navigation components
# Set to 'false' to use original navigation (default)
REACT_APP_ENHANCED_NAVIGATION=false

# Add this line to your .env file for testing:
# REACT_APP_ENHANCED_NAVIGATION=true

# Other existing environment variables...
VITE_API_URL=http://localhost:3000
NODE_ENV=development