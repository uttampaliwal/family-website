# Multi-stage Dockerfile for optimized Web build
FROM node:20-alpine AS base

WORKDIR /app

# Install dependencies needed for build
RUN apk add --no-cache curl

# Update npm and set configurations
RUN npm install -g npm@latest && \
    npm config set fund false && \
    npm config set audit false

# Copy package files
COPY package*.json ./
COPY turbo.json ./

# Stage 2: Install dependencies
FROM base AS deps
COPY apps/web/package*.json ./apps/web/
RUN npm ci --only=production --ignore-scripts

# Stage 3: Build the application
FROM base AS builder
ARG TURBO_TELEMETRY_DISABLED=1
ENV TURBO_TELEMETRY_DISABLED=$TURBO_TELEMETRY_DISABLED

# Copy source files
COPY . .

# Install all dependencies (including dev)
RUN npm ci --ignore-scripts

# Build the web application
RUN npx turbo run build --filter=web

# Stage 4: Production runner with Nginx
FROM nginx:stable-alpine AS runner

# Install curl for health checks
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S nginx-user -u 1001 -G nginx-user

# Copy built assets
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy optimized nginx configuration
COPY apps/web/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Set ownership of nginx files
RUN chown -R nginx-user:nginx-user /usr/share/nginx/html && \
    chown -R nginx-user:nginx-user /var/cache/nginx && \
    chown -R nginx-user:nginx-user /var/log/nginx && \
    chown -R nginx-user:nginx-user /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx-user:nginx-user /var/run/nginx.pid

# Switch to non-root user
USER nginx-user

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5173 || exit 1

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]